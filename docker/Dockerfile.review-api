# Stage 1: Build & Prune
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate
RUN apk add --no-cache python3 make g++
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/typescript/package.json packages/contracts/typescript/
COPY services/review-api/package.json services/review-api/

RUN pnpm install --frozen-lockfile

COPY packages/contracts/typescript packages/contracts/typescript
COPY services/review-api services/review-api

RUN pnpm --filter @ulpf/contracts build
RUN pnpm --filter @ulpf/review-api build

# Stage 2: Hardened Minimal Runtime
FROM node:20-alpine AS runner

RUN apk add --no-cache curl tzdata && rm -rf /var/cache/apk/*
ENV NODE_ENV=production
ENV PORT=4000

WORKDIR /app

COPY --chown=node:node --from=builder /app /app
RUN mkdir -p /app/data && chown -R node:node /app/data && chmod 777 /app/data
RUN chmod 777 /app

USER node

EXPOSE 4000

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:4000/health || exit 1

CMD ["node", "services/review-api/dist/index.js"]
