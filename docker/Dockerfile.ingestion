# Stage 1: Build & Prune
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate
RUN apk add --no-cache python3 make g++
WORKDIR /app

# Copy root manifests and lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/typescript/package.json packages/contracts/typescript/
COPY services/ingestion-svc/package.json services/ingestion-svc/

# Install all dependencies for build
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/contracts/typescript packages/contracts/typescript
COPY services/ingestion-svc services/ingestion-svc

# Build contracts and ingestion-svc
RUN pnpm --filter @ulpf/contracts build
RUN pnpm --filter @ulpf/ingestion-svc build

# Stage 2: Hardened Minimal Runtime
FROM node:20-alpine AS runner

RUN apk add --no-cache curl tzdata && rm -rf /var/cache/apk/*
ENV NODE_ENV=production
ENV PORT=5142
ENV SYSLOG_UDP_PORT=5140
ENV SYSLOG_TCP_PORT=5141

WORKDIR /app

COPY --chown=node:node --from=builder /app /app
RUN mkdir -p /app/data && chown -R node:node /app/data && chmod 777 /app/data
RUN chmod 777 /app

USER node

EXPOSE 5140/udp 5141/tcp 5142/tcp

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -fsS http://localhost:5142/health || exit 1

CMD ["node", "services/ingestion-svc/dist/index.js"]
