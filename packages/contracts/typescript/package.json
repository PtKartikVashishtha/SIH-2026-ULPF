    "ajv": "^8.16.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.5.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
