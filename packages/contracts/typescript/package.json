{
  "name": "@ulpf/contracts",
  "version": "0.1.0",
  "description": "ULPF shared contracts — TypeScript types generated from JSON Schema",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
