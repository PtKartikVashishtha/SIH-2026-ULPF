{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulpf.internal/schemas/error-response.json",
  "title": "ErrorResponse",
  "description": "Unified error response shape used by all REST endpoints across every service (design.md §5).",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error description."
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional structured details."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
